# FamZoo Credentials
FAMZOO_FAMILY_NAME=your_family_sign_in_name
FAMZOO_MEMBER_NAME=your_member_sign_in_name
FAMZOO_PASSWORD=your_password

# FamZoo Account Name
# This should match (or partially match) the account name in the FamZoo dropdown
# Examples: "Alex", "Kids Spending", "Family Allowance"
FAMZOO_ACCOUNT_NAME=Kids Spending

# YNAB API Configuration
# Get your API token from: https://app.ynab.com/settings/developer
YNAB_API_TOKEN=your_ynab_api_token

# YNAB Budget ID (use "last-used" for your most recently accessed budget, or the actual budget ID)
YNAB_BUDGET_ID=last-used

# YNAB Account ID (the account where FamZoo transactions will be imported)
# You can find this in YNAB URL when viewing the account, or via API
YNAB_ACCOUNT_ID=your_account_id

# YNAB Transfer Account ID (optional - for FamZoo transfers like "Transfer from Family for Child:")
# Set this to the account ID of your Checking account so transfers appear properly linked
# Use the list-accounts command to find your account IDs
YNAB_TRANSFER_ACCOUNT_ID=your_checking_account_id

# Personal Payee Mappings (optional - JSON format)
# Add your local merchants to normalize payee names in YNAB
# Pattern is matched case-insensitively against the payee name
# Example:
# PAYEE_MAPPINGS={"LOCAL COFFEE": "My Favorite Coffee Shop", "JOES PIZZA": "Joe's Pizza"}
